# Broker-disabled paper/staging RC1 only. Do not reuse as a LIVE trading image.
FROM node:22-bookworm-slim AS builder
WORKDIR /app
RUN apt-get update -qq \
    && apt-get install -y --no-install-recommends python3 make g++ \
    && rm -rf /var/lib/apt/lists/*
COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY . .
RUN NODE_ENV=production npm run build \
    && npm prune --omit=dev --no-audit --no-fund

FROM node:22-bookworm-slim
ENV NODE_ENV=production \
    PAPER_STAGING_MODE=1 \
    DATA_PROVIDER=practice \
    PAPER_STAGING_DB_DIR=/data \
    PORT=3000
WORKDIR /app
COPY --from=builder --chown=node:node /app/package.json ./package.json
COPY --from=builder --chown=node:node /app/node_modules ./node_modules
COPY --from=builder --chown=node:node /app/dist ./dist
COPY --from=builder --chown=node:node /app/src/server/migrations ./src/server/migrations
COPY --from=builder --chown=node:node /app/assets ./assets
RUN mkdir -p /data \
    && chown node:node /data \
    && chmod 0700 /data
USER node
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||3000)+'/api/release/status').then(async r=>{const d=await r.json();if(!r.ok||d.paperOnly!==true||d.liveBrokerOrdersAuthorized!==false)process.exit(1)}).catch(()=>process.exit(1))"
CMD ["node","dist/server.cjs"]
