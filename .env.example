# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Upstox v2 API Integration (Live Market Feed, Quotes, Margins, Orders)
UPSTOX_API_KEY=""
UPSTOX_API_SECRET=""
UPSTOX_REDIRECT_URI="https://option-chain-trading-platform.ai.studio/api/upstox/callback"
UPSTOX_ACCESS_TOKEN=""

# Upstox Automated TOTP Morning Refresh (Zero-Manual Daily Token Login)
# UPSTOX_MOBILE_NO or UPSTOX_CLIENT_ID: Your 10-digit registered mobile or 6-char UCC
UPSTOX_MOBILE_NO=""
UPSTOX_CLIENT_ID=""
UPSTOX_PIN=""
UPSTOX_TOTP_SECRET=""

# -------------------------------------------------------------
# Fixed User Terminal Authentication
# Set each value via secure deployment secrets; NEVER commit real credentials.
# Production disables unmanaged fixed accounts when matching credentials are absent.
# Rotate any passwords that were previously generated from older examples.
# -------------------------------------------------------------
ADMIN_EMAIL=""
ADMIN_NAME="Master Administrator"
ADMIN_INITIAL_PASSWORD=""

OPERATOR_1_EMAIL=""
OPERATOR_1_NAME="Quant Operator 1"
OPERATOR_1_INITIAL_PASSWORD=""

OPERATOR_2_EMAIL=""
OPERATOR_2_NAME="Quant Operator 2"
OPERATOR_2_INITIAL_PASSWORD=""

OPERATOR_3_EMAIL=""
OPERATOR_3_NAME="Risk Operator 3"
OPERATOR_3_INITIAL_PASSWORD=""

OPERATOR_4_EMAIL=""
OPERATOR_4_NAME="Execution Operator 4"
OPERATOR_4_INITIAL_PASSWORD=""

# Required in production: random signing secret, minimum 32 characters.
# Generate externally, e.g. openssl rand -hex 32; do not paste it into Git.
JWT_SECRET=""

# Required to reset a halted quant kill-switch; unique random 32+ character key.
QUANT_SUPERVISOR_RESET_KEY=""
# Hostinger SMTP Configuration for Email Verification & Password Reset
# (Default Hostinger settings: smtp.hostinger.com, SSL Port 465 or TLS Port 587)
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_USER="noreply@aaditechs.in"
SMTP_PASS="your-hostinger-email-password"
SMTP_FROM="noreply@aaditechs.in"
APP_BASE_URL="http://localhost:3000"

# Telegram Bot Notifications for 15-Minute EMA Alerts (REQUIRED if you want Telegram alerts)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
