# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Upstox v2 API Integration (Live Market Feed, Quotes, Margins, Orders)
UPSTOX_API_KEY=""
UPSTOX_API_SECRET=""
UPSTOX_REDIRECT_URI="https://option-chain-trading-platform.ai.studio/api/upstox/callback"
UPSTOX_ACCESS_TOKEN=""

# Phase N Authentication Configuration
# VITE_GOOGLE_CLIENT_ID / GOOGLE_CLIENT_ID: Google Cloud Console -> Credentials -> OAuth 2.0 Client ID -> Web application
VITE_GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_ID="your-google-oauth-client-id.apps.googleusercontent.com"
# JWT_SECRET: Secret string used for signing session JWT tokens
JWT_SECRET="generate-a-long-random-string-for-signing-session-tokens"
# Hostinger SMTP Configuration for Email Verification & Password Reset
# (Default Hostinger settings: smtp.hostinger.com, SSL Port 465 or TLS Port 587)
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_USER="noreply@aaditechs.in"
SMTP_PASS="your-hostinger-email-password"
SMTP_FROM="noreply@aaditechs.in"
APP_BASE_URL="http://localhost:3000"

# Telegram Bot Notifications for 15-Minute EMA Alerts (Optional server-wide fallback)
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""
