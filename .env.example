# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Upstox v2 API Integration (Live Market Feed, Quotes, Margins, Orders)
UPSTOX_API_KEY=""
UPSTOX_API_SECRET=""
UPSTOX_REDIRECT_URI="https://option-chain-trading-platform.ai.studio/api/upstox/callback"
UPSTOX_ACCESS_TOKEN=""

# Upstox Automated TOTP Morning Refresh (Zero-Manual Daily Token Login)
# UPSTOX_MOBILE_NO or UPSTOX_CLIENT_ID: Your 10-digit registered mobile or 6-char UCC
UPSTOX_MOBILE_NO=""
UPSTOX_CLIENT_ID=""
UPSTOX_PIN=""
UPSTOX_TOTP_SECRET=""

# -------------------------------------------------------------
